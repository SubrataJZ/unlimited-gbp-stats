# ── Unlimited GBP Stats — Sync Server Config ──────────────────────────────────
# Copy this file to .env and fill in your values.

# Port the server listens on
PORT=3000

# Secret API key — the extension uses this to authenticate.
# Generate a strong random string (e.g. openssl rand -hex 32)
API_KEY=change-me-to-a-long-random-secret

# Path to the SQLite database file (relative to server.js)
DB_PATH=./gbp_data.sqlite

# Optional: set to "true" to log every incoming sync request
VERBOSE=false
