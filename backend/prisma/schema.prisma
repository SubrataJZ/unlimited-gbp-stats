generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  // Nullable: password-only accounts have no Google identity. Postgres allows
  // many NULLs under a UNIQUE index, so this still enforces one row per googleId.
  googleId  String? @unique @map("google_id")
  email     String  @unique
  name      String?
  avatarUrl String? @map("avatar_url")

  // Email/password auth. Null for Google-only accounts.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  locations      Location[]
  businesses     Business[]
  apiKeys        ApiKey[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  memberships    Membership[]
  aiUsage        AiUsage[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

// ── Password reset tokens ─────────────────────────────────────────────────────
// A single-use, short-lived token. Only the SHA-256 hash of the token is stored,
// so a DB read cannot be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @map("key_hash")
  prefix     String
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, name])
  @@index([prefix])
  @@map("api_keys")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  status    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Business {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  reviews     Review[]
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@index([userId])
  @@map("businesses")
}

model Review {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String?
  rating        Int
  text          String
  approved      Boolean  @default(false)
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")

  @@index([businessId])
  @@index([approved])
  @@map("reviews")
}

model Location {
  id               String @id @default(uuid())
  googleLocationId String @unique @map("google_location_id")
  businessName     String @map("business_name")
  userId           String @map("user_id")
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  metrics        Metric[]
  reports        Report[]
  yoyComparisons YoYComparison[]
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@map("locations")
}

model Metric {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [googleLocationId], onDelete: Cascade)

  date       DateTime @map("date") @db.Date
  metricType String   @map("metric_type")
  value      Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([locationId, date, metricType])
  @@index([locationId])
  @@index([date])
  @@map("metrics")
}

model Report {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [googleLocationId], onDelete: Cascade)

  reportType     String   @map("report_type")
  dateRangeStart DateTime @map("date_range_start") @db.Date
  dateRangeEnd   DateTime @map("date_range_end") @db.Date

  htmlContent String @map("html_content")
  pdfContent  Bytes? @map("pdf_content")

  generatedAt    DateTime  @default(now()) @map("generated_at")
  expiresAt      DateTime? @map("expires_at")
  downloadUrl    String?   @map("download_url")
  recipientEmail String?   @map("recipient_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locationId])
  @@index([generatedAt])
  @@index([expiresAt])
  @@map("reports")
}

model YoYComparison {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [googleLocationId], onDelete: Cascade)

  metricType String @map("metric_type")
  year       Int
  month      Int

  currentValue   Int    @map("current_value")
  priorYearValue Int?   @map("prior_year_value")
  yoyPercent     Float? @map("yoy_percent")

  calculatedAt DateTime @default(now()) @map("calculated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([locationId, metricType, year, month])
  @@index([locationId])
  @@index([year, month])
  @@map("yoy_comparisons")
}

// ── GBP Sentinel Pro models ───────────────────────────────────────────────────

enum Role {
  AGENCY_ADMIN
  AGENCY_MEMBER
  OWNER_READONLY
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  plan          Plan      @default(FREE)
  planExpiresAt DateTime? @map("plan_expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships       Membership[]
  trackedBusinesses TrackedBusiness[]
  licenseKeys       LicenseKey[]

  @@map("organizations")
}

// ── License keys ──────────────────────────────────────────────────────────────
// Sold on a marketplace / handed out manually, redeemed via POST /api/billing/
// redeem which sets Organization.plan + planExpiresAt. Single-use.
model LicenseKey {
  id              String        @id @default(cuid())
  code            String        @unique
  plan            Plan
  durationDays    Int           @default(365) @map("duration_days")
  note            String?
  redeemedByOrgId String?       @map("redeemed_by_org_id")
  redeemedBy      Organization? @relation(fields: [redeemedByOrgId], references: [id], onDelete: SetNull)
  redeemedAt      DateTime?     @map("redeemed_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([redeemedByOrgId])
  @@map("license_keys")
}

model Membership {
  id     String @id @default(cuid())
  userId String @map("user_id")
  orgId  String @map("org_id")
  role   Role

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model TrackedBusiness {
  id            String  @id @default(cuid())
  orgId         String  @map("org_id")
  googlePlaceId String? @map("google_place_id")
  name          String
  address       String?
  searchUrl     String? @map("search_url")
  logoUrl       String? @map("logo_url")
  isOwn         Boolean @default(false) @map("is_own")
  locationId    String? @map("location_id")

  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots      ProfileSnapshot[]
  scrapedReviews ScrapedReview[]
  metricMonths   MetricMonth[]
  context        BusinessContext?
  concepts       ReviewConcept[]

  @@unique([orgId, googlePlaceId])
  @@index([orgId])
  @@map("tracked_businesses")
}

model ProfileSnapshot {
  id                      String   @id @default(cuid())
  trackedBusinessId       String   @map("tracked_business_id")
  capturedOn              DateTime @map("captured_on") @db.Date
  totalReviews            Int      @map("total_reviews")
  displayRating           Float?   @map("display_rating")
  trueAverage             Float?   @map("true_average")
  reviewsWithPhotos       Int      @default(0) @map("reviews_with_photos")
  localGuideReviews       Int      @default(0) @map("local_guide_reviews")
  avgReviewerContribution Float?   @map("avg_reviewer_contribution")

  trackedBusiness TrackedBusiness @relation(fields: [trackedBusinessId], references: [id], onDelete: Cascade)

  @@unique([trackedBusinessId, capturedOn])
  @@index([trackedBusinessId])
  @@map("profile_snapshots")
}

/// Monthly GBP performance metrics scraped by the extension.
///
/// Deliberately month-grained, unlike the older daily `Metric` model: the
/// extension's unit of collection is one month of one metric type, carrying a
/// `daily` array plus a YoY percentage and two nested breakdowns that have no
/// place in a flat (date, value) row. Forcing that shape into `Metric` is what
/// left the metrics pipeline stranded on the legacy SQLite server.
///
/// Tenancy scopes through TrackedBusiness -> Organization, matching
/// ProfileSnapshot and ScrapedReview. There is no denormalized orgId, so
/// org-scoping cannot drift out of sync with the parent row.
model MetricMonth {
  id                String @id @default(cuid())
  trackedBusinessId String @map("tracked_business_id")

  /// Extension vocabulary: overview | calls | chat_clicks | bookings |
  /// directions | website_clicks. Validated at the ingest boundary, not here.
  metricType String @map("metric_type")
  year       Int
  month      Int

  total Int

  /// One entry per day of the month, in day order. Absent for derived rows.
  daily Json?

  /// Year-over-year change as reported by Google, e.g. -12.5 for -12.5%.
  yoyPercent Float? @map("yoy_percent")

  /// { searchMobile, searchDesktop, mapsMobile, mapsDesktop }
  breakdown Json?

  /// [{ term, count }]
  searchTerms Json? @map("search_terms")

  /// True when back-computed from a later month's YoY percentage rather than
  /// scraped directly. A derived row must never overwrite a scraped one.
  isDerived Boolean @default(false) @map("is_derived")

  /// Provenance, e.g. "extension" | "sqlite-backfill".
  source String @default("extension")

  /// When the extension captured this, as opposed to when we stored it.
  collectedAt DateTime? @map("collected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trackedBusiness TrackedBusiness @relation(fields: [trackedBusinessId], references: [id], onDelete: Cascade)

  @@unique([trackedBusinessId, metricType, year, month])
  @@index([trackedBusinessId])
  @@index([year, month])
  @@map("metric_months")
}

model ScrapedReview {
  id                String    @id @default(cuid())
  trackedBusinessId String    @map("tracked_business_id")
  externalReviewId  String    @map("external_review_id")
  authorName        String?   @map("author_name")
  authorId          String?   @map("author_id")
  authorReviewCount Int?      @map("author_review_count")
  isLocalGuide      Boolean   @default(false) @map("is_local_guide")
  hasPhoto          Boolean   @default(false) @map("has_photo")
  ownerResponded    Boolean   @default(false) @map("owner_responded")
  rating            Int
  text              String?
  reviewedAt        DateTime? @map("reviewed_at")
  scrapedAt         DateTime  @default(now()) @map("scraped_at")

  trackedBusiness TrackedBusiness        @relation(fields: [trackedBusinessId], references: [id], onDelete: Cascade)
  reply           ReviewReply?
  analysis        ReviewAnalysis?
  conceptMentions ReviewConceptMention[]

  @@unique([trackedBusinessId, externalReviewId])
  @@index([trackedBusinessId])
  @@map("scraped_reviews")
}

/// One row per review that the concept extractor has already processed.
///
/// Exists purely so we never pay OpenRouter twice for the same review. Kept
/// separate from ScrapedReview because the extension re-upserts that row on
/// every scrape; a marker living there would have to survive merge semantics
/// it was never designed for. A review that yields zero concepts still gets a
/// row here — "analysed, found nothing" and "not yet analysed" must not look
/// alike, or the backfill would retry empty reviews forever.
model ReviewAnalysis {
  id              String   @id @default(cuid())
  scrapedReviewId String   @unique @map("scraped_review_id")
  model           String
  /// BCP-47-ish tag the model reported for the review body: en | hi | bn | ...
  language        String?
  /// Overall review sentiment, independent of any single concept.
  sentiment       String?
  analyzedAt      DateTime @default(now()) @map("analyzed_at")

  scrapedReview ScrapedReview @relation(fields: [scrapedReviewId], references: [id], onDelete: Cascade)

  @@map("review_analyses")
}

/// A thing customers talk about, discovered from the reviews themselves.
///
/// `label` is a canonical lowercase English noun phrase chosen by the model —
/// that canonicalisation is the whole point. "biryani", "বিরিয়ানি" and
/// "बिरयानी" must collapse to ONE concept, and they do so because the model
/// normalises, not because we shipped a synonym table. There are deliberately
/// no hardcoded keyword rules anywhere in this feature.
///
/// `aliases` records the surface forms actually seen, so the dashboard can show
/// an owner the words their customers really typed.
model ReviewConcept {
  id                String @id @default(cuid())
  trackedBusinessId String @map("tracked_business_id")

  label String
  /// Coarse bucket the model assigns: dish | service | staff | facility |
  /// price | other. Advisory only — never validated against a fixed list, so a
  /// new kind of business can surface its own vocabulary.
  kind  String @default("other")

  /// string[] — surface forms seen in any script, deduped.
  aliases Json @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trackedBusiness TrackedBusiness        @relation(fields: [trackedBusinessId], references: [id], onDelete: Cascade)
  mentions        ReviewConceptMention[]

  @@unique([trackedBusinessId, label])
  @@index([trackedBusinessId])
  @@map("review_concepts")
}

/// One review talking about one concept, with the sentiment of that mention.
///
/// Sentiment is per-mention rather than per-review because a single review
/// routinely praises the food and damns the wait — collapsing that to one
/// score would destroy exactly the signal an owner needs.
model ReviewConceptMention {
  id              String @id @default(cuid())
  conceptId       String @map("concept_id")
  scrapedReviewId String @map("scraped_review_id")

  /// positive | negative | neutral
  sentiment String
  /// The surface form as written, in the reviewer's own script.
  surface   String?

  createdAt DateTime @default(now()) @map("created_at")

  concept       ReviewConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  scrapedReview ScrapedReview @relation(fields: [scrapedReviewId], references: [id], onDelete: Cascade)

  @@unique([conceptId, scrapedReviewId])
  @@index([conceptId])
  @@index([scrapedReviewId])
  @@map("review_concept_mentions")
}

model BusinessContext {
  id                String  @id @default(cuid())
  trackedBusinessId String  @unique @map("tracked_business_id")
  tone              String?
  services          String?
  ownerName         String? @map("owner_name")
  signature         String?

  trackedBusiness TrackedBusiness @relation(fields: [trackedBusinessId], references: [id], onDelete: Cascade)

  @@map("business_contexts")
}

model ReviewReply {
  id              String   @id @default(cuid())
  scrapedReviewId String   @unique @map("scraped_review_id")
  draftText       String   @map("draft_text")
  finalText       String?  @map("final_text")
  status          String   @default("draft")
  model           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  scrapedReview ScrapedReview @relation(fields: [scrapedReviewId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  feature   String
  model     String
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  costUsd   Float    @default(0) @map("cost_usd")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_usage")
}
