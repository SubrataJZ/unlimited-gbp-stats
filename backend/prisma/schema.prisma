generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  googleId     String         @unique @map("google_id")
  email        String         @unique
  name         String?
  avatarUrl    String?        @map("avatar_url")
  accessToken  String?        @map("access_token")
  refreshToken String?        @map("refresh_token")

  locations     Location[]
  businesses    Business[]
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @map("key_hash")
  prefix     String
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, name])
  @@index([prefix])
  @@map("api_keys")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  status    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Business {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  reviews     Review[]
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@index([userId])
  @@map("businesses")
}

model Review {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String?
  rating        Int
  text          String
  approved      Boolean  @default(false)
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")

  @@index([businessId])
  @@index([approved])
  @@map("reviews")
}

model Location {
  id                String   @id @default(uuid())
  googleLocationId  String   @unique @map("google_location_id")
  businessName      String   @map("business_name")
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  metrics           Metric[]
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("locations")
}

model Metric {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [googleLocationId], onDelete: Cascade)

  date       DateTime @db.Date @map("date")
  metricType String   @map("metric_type")
  value      Int

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([locationId, date, metricType])
  @@index([locationId])
  @@index([date])
  @@map("metrics")
}
