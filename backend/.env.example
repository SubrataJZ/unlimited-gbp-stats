# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Server
PORT=3001
NODE_ENV=development

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gbp.zixify.zixai.in/api/auth/google/callback

# URLs
API_BASE_URL=https://gbp.zixify.zixai.in
FRONTEND_URL=https://zixify.zixai.in
# Public URL of the server-rendered auth pages (login/signup/forgot/reset).
# Must match the proxy: behind the /backend/ prefix it's .../backend/auth.
AUTH_PAGES_URL=https://gbp.zixify.zixai.in/backend/auth

# Transactional email (Hostinger SMTP) — used for password-reset links.
# Leave blank in dev/CI: emails are logged instead of sent, nothing breaks.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@zixai.in
SMTP_PASS=
SMTP_FROM=Unlimited GBP Stats <no-reply@zixai.in>

# Extension
EXTENSION_ID=

# Logging
LOG_LEVEL=info

# AI Review Reply Copilot (OpenRouter) — set the real key only on the server
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
AI_MONTHLY_COST_CAP_USD=5
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=
