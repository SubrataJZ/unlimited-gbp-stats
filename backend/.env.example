# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Server
PORT=3001
NODE_ENV=development

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gbp.zixify.zixai.in/api/auth/google/callback

# URLs
API_BASE_URL=https://gbp.zixify.zixai.in
FRONTEND_URL=https://zixify.zixai.in

# Extension
EXTENSION_ID=

# Logging
LOG_LEVEL=info
