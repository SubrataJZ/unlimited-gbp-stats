# ─── Database ───────────────────────────────────────────────────────────
# PostgreSQL connection string (docker-compose sets this automatically)
DATABASE_URL=postgresql://gbp_user:gbp_dev_password_change_in_production@localhost:5432/gbp_stats_production

# ─── Application ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Authentication ─────────────────────────────────────────────────────
# JWT secret for API tokens (generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# NextAuth.js configuration
NEXTAUTH_SECRET=your_nextauth_secret_change_in_production
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth 2.0 ───────────────────────────────────────────────────
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# For production, also configure:
# GOOGLE_REDIRECT_URI_PROD=https://yourdomain.com/auth/google/callback

# ─── API Configuration ──────────────────────────────────────────────────
# API key for Chrome extension authentication (fire-and-forget sync)
EXTENSION_API_KEY=your_extension_api_key_change_in_production

# ─── Email Configuration (optional) ──────────────────────────────────────
# For server push notifications and webhooks
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@example.com

# ─── Logging & Debug ────────────────────────────────────────────────────
LOG_LEVEL=debug
VERBOSE=true
