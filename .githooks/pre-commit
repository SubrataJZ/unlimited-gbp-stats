#!/bin/sh
#
# SemVer guard — blocks commits that change product code without a matching
# version bump. Enforces the project's mandatory versioning policy so it can
# never be silently skipped again.
#
# Rules:
#   1. Extension  — any staged file under unlimited-gbp-stats/ (excluding the
#      server/ subdir, manifest.json and CHANGELOG.md) requires the
#      manifest.json "version" to change AND CHANGELOG.md to be staged.
#   2. Sync server — any staged file under unlimited-gbp-stats/server/
#      (excluding its package.json) requires server/package.json "version"
#      to change.
#   3. Backend     — any staged file under backend/ (excluding its
#      package.json) requires backend/package.json "version" to change.
#
# Bypass (use only when you truly mean it): git commit --no-verify
#
set -e

staged=$(git diff --cached --name-only)

# Was the "version" field changed in a staged file? (ignores "manifest_version")
version_bumped() {
  git diff --cached -U0 -- "$1" | grep -E '^\+' | grep -q '"version"'
}

fail() {
  echo ""
  echo "  ✗ COMMIT BLOCKED — SemVer policy"
  echo "  ----------------------------------------------------------------"
  printf '%s\n' "$1"
  echo "  ----------------------------------------------------------------"
  echo "  PATCH=bug fix · MINOR=new feature · MAJOR=breaking change"
  echo "  To bypass intentionally: git commit --no-verify"
  echo ""
  exit 1
}

# ── Rule 1: Chrome extension ─────────────────────────────────────────────────
ext_code=$(echo "$staged" \
  | grep '^unlimited-gbp-stats/' \
  | grep -v '^unlimited-gbp-stats/server/' \
  | grep -v '^unlimited-gbp-stats/manifest.json$' \
  | grep -v '^unlimited-gbp-stats/CHANGELOG.md$' || true)

if [ -n "$ext_code" ]; then
  if ! version_bumped unlimited-gbp-stats/manifest.json; then
    fail "  Extension code changed but manifest.json \"version\" was not bumped.
  Bump \"version\" in unlimited-gbp-stats/manifest.json and re-stage it.
  Changed: $(echo "$ext_code" | tr '\n' ' ')"
  fi
  if ! echo "$staged" | grep -q '^unlimited-gbp-stats/CHANGELOG.md$'; then
    fail "  manifest.json was bumped but CHANGELOG.md was not updated.
  Add a '## [X.Y.Z] - $(date +%Y-%m-%d)' entry to
  unlimited-gbp-stats/CHANGELOG.md and re-stage it."
  fi
fi

# ── Rule 2: Sync server ──────────────────────────────────────────────────────
server_code=$(echo "$staged" \
  | grep '^unlimited-gbp-stats/server/' \
  | grep -v '^unlimited-gbp-stats/server/package.json$' || true)

if [ -n "$server_code" ]; then
  if ! version_bumped unlimited-gbp-stats/server/package.json; then
    fail "  Sync-server code changed but server/package.json \"version\" was not bumped.
  Bump \"version\" in unlimited-gbp-stats/server/package.json and re-stage it.
  Changed: $(echo "$server_code" | tr '\n' ' ')"
  fi
fi

# ── Rule 3: Backend API ──────────────────────────────────────────────────────
backend_code=$(echo "$staged" \
  | grep '^backend/' \
  | grep -v '^backend/package.json$' || true)

if [ -n "$backend_code" ]; then
  if ! version_bumped backend/package.json; then
    fail "  Backend code changed but backend/package.json \"version\" was not bumped.
  Bump \"version\" in backend/package.json and re-stage it.
  Changed: $(echo "$backend_code" | tr '\n' ' ')"
  fi
fi

# ── Guard 1: Secret scan ─────────────────────────────────────────────────────
# Block if staged added lines contain known secret patterns.
staged_diff=$(git diff --cached -U0 | grep '^+' || true)

# Build the forbidden-fallback pattern at runtime so this script file does not
# contain the literal string and cannot self-trigger.
_p1="change-this-secret"; _p2="-in-env"; _bad_fallback="${_p1}${_p2}"

if echo "$staged_diff" | grep -q "$_bad_fallback"; then
  echo ""
  echo "  ✗ COMMIT BLOCKED — Secret scan"
  echo "  ----------------------------------------------------------------"
  echo "  Staged diff contains the hardcoded JWT fallback secret."
  echo "  Remove it and require JWT_SECRET from env before committing."
  echo "  ----------------------------------------------------------------"
  echo ""
  exit 1
fi

if echo "$staged_diff" | grep -qE 'sk-or-[A-Za-z0-9_-]+'; then
  echo ""
  echo "  ✗ COMMIT BLOCKED — Secret scan"
  echo "  ----------------------------------------------------------------"
  echo "  Staged diff contains an OpenRouter API key (sk-or-...)."
  echo "  Remove it and use an environment variable instead."
  echo "  ----------------------------------------------------------------"
  echo ""
  exit 1
fi

if echo "$staged_diff" | grep -qE 'OPENROUTER_API_KEY\s*=\s*.+'; then
  echo ""
  echo "  ✗ COMMIT BLOCKED — Secret scan"
  echo "  ----------------------------------------------------------------"
  echo "  Staged diff contains an OPENROUTER_API_KEY assignment with a value."
  echo "  Never commit API keys — use environment variables or a secrets manager."
  echo "  ----------------------------------------------------------------"
  echo ""
  exit 1
fi

# Extra check: OpenRouter key material must never appear in client/extension code
client_secret=$(git diff --cached --name-only | grep '^unlimited-gbp-stats/' | while read f; do
  git show ":$f" 2>/dev/null | grep -E 'sk-or-[A-Za-z0-9_-]+|OPENROUTER_API_KEY\s*=\s*.+' || true
done)

if [ -n "$client_secret" ]; then
  echo ""
  echo "  ✗ COMMIT BLOCKED — Secret scan (client code)"
  echo "  ----------------------------------------------------------------"
  echo "  An OpenRouter key or OPENROUTER_API_KEY value was found inside"
  echo "  unlimited-gbp-stats/ (client/extension code). The AI key must"
  echo "  ONLY exist server-side (backend/). Remove it from extension files."
  echo "  ----------------------------------------------------------------"
  echo ""
  exit 1
fi

# ── Guard 2: Manifest host-permission check ───────────────────────────────────
if echo "$staged" | grep -q '^unlimited-gbp-stats/manifest.json$'; then
  manifest_content=$(git show :unlimited-gbp-stats/manifest.json 2>/dev/null || true)
  if echo "$manifest_content" | grep -qE '"https://\*/\*"|\"\*://\*/\*\"'; then
    echo ""
    echo "  ✗ COMMIT BLOCKED — Manifest host-permission guard"
    echo "  ----------------------------------------------------------------"
    echo "  unlimited-gbp-stats/manifest.json contains an over-broad wildcard"
    echo "  host_permission (\"https://*/*\" or \"*://*/*\"). This violates Chrome"
    echo "  Web Store policy. Remove the wildcard entry and use specific origins."
    echo "  ----------------------------------------------------------------"
    echo ""
    exit 1
  fi
fi

# ── Guard 3: Deprecated-backend warning (soft) ───────────────────────────────
deprecated_server=$(echo "$staged" \
  | grep '^unlimited-gbp-stats/server/' \
  | grep -v '^unlimited-gbp-stats/server/package.json$' || true)

if [ -n "$deprecated_server" ]; then
  echo ""
  echo "  ⚠ WARNING — Frozen backend"
  echo "  ----------------------------------------------------------------"
  echo "  You are committing changes to unlimited-gbp-stats/server/ which"
  echo "  is FROZEN (security-only fixes, scheduled for deletion)."
  echo "  If this is a security fix, proceed. For any new feature work,"
  echo "  target backend/ (TypeScript + Prisma) instead."
  echo "  Files: $(echo "$deprecated_server" | tr '\n' ' ')"
  echo "  ----------------------------------------------------------------"
  echo "  Commit proceeding despite warning."
  echo ""
fi

exit 0
